const body=box.querySelector('#vn-body'), hh=box.querySelector('#vn-h');
function place(x,y){const r=box.getBoundingClientRect();
  box.style.left=Math.min(Math.max(8,x),innerWidth-r.width-8)+'px';
  box.style.top=Math.min(Math.max(8,y),innerHeight-r.height-8)+'px';
  box.style.right=box.style.bottom='auto'}
try{const p=LS.get('pos',null);if(p)place(p.x,p.y)}catch(e){}
let drag=null;
hh.addEventListener('pointerdown',e=>{
  if(e.target.closest('button,input,select,label'))return;
  const r=box.getBoundingClientRect();drag={dx:e.clientX-r.left,dy:e.clientY-r.top};
  hh.classList.add('drag');try{hh.setPointerCapture(e.pointerId)}catch(_){}
  e.preventDefault()});
hh.addEventListener('pointermove',e=>{if(drag)place(e.clientX-drag.dx,e.clientY-drag.dy)});
const soltar=()=>{if(!drag)return;drag=null;hh.classList.remove('drag');
  const r=box.getBoundingClientRect();LS.set('pos',{x:r.left,y:r.top})};
hh.addEventListener('pointerup',soltar);hh.addEventListener('pointercancel',soltar);

let aba='main';
const irPara=t=>{aba=t;box.querySelectorAll('#vn-tabs button').forEach(b=>b.classList.toggle('on',b.dataset.t===t));desenhar()};
box.querySelectorAll('#vn-tabs button').forEach(b=>b.onclick=()=>irPara(b.dataset.t));

/* ======================= 9. ESTADO ======================= */
let ultimo=null, rodando=false, baseAtual='', minhaResposta='', avisoAtual='';

function extrair(){
  const texto=lerEnunciado();if(!texto)return null;
  const opcoes=lerOpcoes(),campos=lerCampos();
  const {assunto,tipo}=classificar(texto,opcoes);
  return {texto,opcoes,campos,assunto,tipo,base:hash(texto)};
}
const memGet=k=>LS.get('mem:'+k,null);
const memSet=(k,v)=>LS.set('mem:'+k,v);
const histAdd=e=>{const h=LS.get('hist',[]);h.unshift(Object.assign({t:Date.now()},e));LS.set('hist',h.slice(0,200))};

/* troca de questão limpa o resultado anterior */
function checarTroca(){
  const p=extrair();
  if(!p)return false;
  if(p.base!==baseAtual){
    baseAtual=p.base;ultimo=null;minhaResposta='';avisoAtual='';
    if(aba==='main')desenhar();
    return true;
  }
  return false;
}

/* ======================= 10. ORQUESTRADOR ======================= */
async function resolver(comIA){
  if(rodando)return;
  const p=extrair();
  if(!p){avisoAtual='Nada legível na página.';desenhar();return}
  baseAtual=p.base;
  const t0=Date.now();
  const r={texto:p.texto,assunto:p.assunto,tipo:p.tipo,metodo:'—',conf:'baixa',
    etapas:[],fonte:'—',ms:0,erro:null,quem:null,valores:[],escolha:null};
  rodando=true;desenhar();
  try{
    const m=memGet(p.base);
    if(m&&m.valores&&m.valores.length&&!comIA){
      Object.assign(r,{valores:m.valores,metodo:m.metodo,etapas:m.etapas||[],conf:m.conf||'media',fonte:'memória'});
      ultimo=r;return;
    }
    /* solucionador local sempre roda: é a camada independente */
    const sol=resolverLocal(p);
    if(!sol.falhou){
      Object.assign(r,{valores:sol.valores,metodo:sol.metodo,etapas:sol.etapas,conf:sol.confianca,fonte:'local'});
      if(p.tipo==='opcoes'&&sol.valores.length){
        const c=MAT.casar(num(sol.valores[0]),p.opcoes);
        if(c){r.escolha=c;r.etapas.push('alternativa correspondente: '+c)}
      }
      if(sol.valores.length)memSet(p.base,{valores:sol.valores,metodo:sol.metodo,etapas:sol.etapas,conf:sol.confianca});
    }else{
      r.etapas.push(sol.motivo);
    }
    if(usarGab()&&p.tipo==='opcoes'){
      const rec=pool.get(p.base+':0');
      if(rec&&rec.correct.length){
        const c=p.opcoes[rec.correct[0]];
        if(c){r.escolha=c;r.etapas.push('gabarito interno: '+c);if(!r.valores.length)r.conf='alta'}
      }
    }
    if(usarDicas()){const d=lerDicas();if(d.length)r.etapas.push('dica da página: '+d.join(' ').slice(0,240))}
    if(comIA&&usarIA()){
      if(!principalId())r.etapas.push('IA ligada, mas nenhuma IA principal escolhida');
      else{
        r.fonte='consultando IA…';ultimo=r;desenhar();
        try{
          const x=await chamarIA(promptDe(p,p.assunto,null),p.assunto);
          r.ia=x.texto;r.quem=x.quem;
          r.fonte=x.fonte==='cache'?'IA (cache)':x.fonte==='junto'?'IA (junto)':x.fonte==='fallback'?'IA (fallback)':'IA';
          if(x.falhas.length)r.etapas.push('falhou antes: '+x.falhas.join(' / '));
          if(!r.valores.length)r.conf='media';
        }catch(e){r.erro=e.message;r.fonte='IA falhou'}
      }
    }
    if(!r.valores.length&&!r.ia&&!r.etapas.length)r.erro='Sem dados suficientes: nenhum padrão reconhecido.';
    histAdd({assunto:p.assunto,tipo:p.tipo,metodo:r.metodo,conf:r.conf,fonte:r.fonte,ms:Date.now()-t0,ok:!r.erro});
  }catch(e){r.erro=e.message}
  finally{
    r.ms=Date.now()-t0;
    ultimo=r;rodando=false;desenhar();
  }
}

/* ======================= 11. AÇÕES ======================= */
function relatorio(){
  if(!ultimo)return '';
  const L=[`Venice · ${ultimo.tipo} · ${ultimo.assunto}`,`método: ${ultimo.metodo}`];
  if(ultimo.valores.length)L.push('resultado: '+ultimo.valores.join(' | '));
  if(ultimo.escolha)L.push('alternativa: '+ultimo.escolha);
  if(ultimo.etapas.length)L.push('','raciocínio:',...ultimo.etapas.map(e=>'· '+e));
  if(ultimo.ia)L.push('','IA'+(ultimo.quem?' ('+ultimo.quem+')':'')+':',ultimo.ia);
  if(ultimo.erro)L.push('','erro: '+ultimo.erro);
  return L.join('\n');
}
async function copiar(){
  const t=relatorio();
  if(!t)return avisoAtual='nada para copiar',desenhar();
  try{await navigator.clipboard.writeText(t);avisoAtual='explicação copiada'}
  catch(e){
    const ta=document.createElement('textarea');ta.value=t;document.body.appendChild(ta);
    ta.select();try{document.execCommand('copy');avisoAtual='explicação copiada'}catch(_){avisoAtual='não consegui copiar'}
    ta.remove();
  }
  desenhar();
}
function conferir(){
  const esperado=ultimo?.escolha||ultimo?.valores?.[0];
  if(!esperado)return avisoAtual='nada calculado para conferir',desenhar();
  if(!minhaResposta.trim())return avisoAtual='digite o que você respondeu',desenhar();
  const a=low(minhaResposta),b=low(esperado);
  let igual=false;
  const na=num(minhaResposta),nb=num(esperado);
  if(na!==null&&nb!==null)igual=Math.abs(na-nb)<1e-6;
  else igual=a===b||a.includes(b)||b.includes(a);
  avisoAtual=igual?'confere com o calculado ✓':'difere — calculado: '+esperado;
  desenhar();
}

/* ======================= 12. ABAS ======================= */
function desenhar(){
  const p=ultimo;
  if(aba==='main'){
    const conf=p?.conf?`<span class="vn-tag t-${p.conf}">${p.conf}</span>`:'';
    const prin=principalId()?`${pById(principalId())?.nome} · ${estDe(principalId()).modelo||'—'}`:'nenhuma';
    body.innerHTML=`
<div class="vn-card"><span class="vn-lbl">tipo</span> ${p?`${p.tipo} · ${p.assunto}`:'—'} ${conf}
 <div class="vn-mini">método: ${p?.metodo||'—'} · fonte: ${p?.fonte||'—'}${p?.ms?` · ${p.ms}ms`:''}</div>
 <div class="vn-mini">IA ${usarIA()?'ligada':'desligada'} · principal: ${prin}${fallbackOn()?' · fallback on':' · fallback off'}</div></div>
<div class="vn-card"><span class="vn-lbl">raciocínio</span>
 ${p?.etapas?.length?p.etapas.map(e=>'<div class="vn-mini">· '+e+'</div>').join(''):'<div class="vn-mini">—</div>'}
 ${p?.valores?.length?`<div style="margin-top:5px;color:#86efac"><b>${p.valores.join(' | ')}</b></div>`:''}
 ${p?.escolha?`<div style="color:#86efac">alternativa: ${p.escolha}</div>`:''}
 ${p?.ia?`<div style="margin-top:6px;white-space:pre-wrap">${p.ia}${p.quem?`<div class="vn-mini">por ${p.quem}</div>`:''}</div>`:''}
 ${p?.erro?`<div style="color:#fca5a5;margin-top:4px">${p.erro}</div>`:''}</div>
${avisoAtual?`<div class="vn-card vn-mini">${avisoAtual}</div>`:''}
<div class="vn-row"><button class="act pri" id="vn-r">${rodando?'…':'Resolver'}</button>
 <button class="act" id="vn-ria">Resolver com IA</button></div>
<div class="vn-row"><button class="act" id="vn-cp">Copiar explicação</button>
 <button class="act" id="vn-cf">Conferir resposta</button></div>
<div class="vn-row"><input class="vn-in" id="vn-minha" placeholder="sua resposta, para conferir" value="${minhaResposta.replace(/"/g,'&quot;')}"></div>`;
    body.querySelector('#vn-r').onclick=()=>resolver(false);
    body.querySelector('#vn-ria').onclick=()=>resolver(true);
    body.querySelector('#vn-cp').onclick=copiar;
    body.querySelector('#vn-cf').onclick=conferir;
    const inp=body.querySelector('#vn-minha');
    inp.oninput=()=>{minhaResposta=inp.value};
    inp.onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();conferir()}};
  }
  if(aba==='local'){
    const q=extrair(),d=lerDicas();
    body.innerHTML=`
<div class="vn-card"><span class="vn-lbl">leitura</span>
 <div class="vn-mini">assunto: ${q?.assunto||'—'} · tipo: ${q?.tipo||'—'} · alternativas: ${q?.opcoes.length||0} · campos: ${q?.campos.length||0}</div>
 <div class="vn-mini" style="margin-top:4px;white-space:pre-wrap">${(q?.texto||'').slice(0,320)||'—'}</div></div>
<div class="vn-card"><span class="vn-lbl">dicas visíveis</span>
 ${d.length?d.map(x=>'<div class="vn-mini">· '+x.slice(0,150)+'</div>').join(''):'<div class="vn-mini">nenhuma</div>'}
 <div class="vn-row"><button class="act" id="vn-dica">mostrar dica</button></div></div>
<div class="vn-card"><span class="vn-lbl">solucionadores ativos</span>
 <div class="vn-mini">${ORDEM.join(' · ')} · dissertativa</div>
 <div class="vn-mini">rodam em cascata, sem rede e sem IA</div></div>`;
    body.querySelector('#vn-dica').onclick=async()=>{
      const b=[...document.querySelectorAll('button')].find(x=>!x.disabled&&/mostrar dicas?|próxima dica|proxima dica/i.test(norm(x.innerText)));
      if(b){b.click();await wait(400)}desenhar()};
  }
  if(aba==='ias')desenharIA();
  if(aba==='hist'){
    const h=LS.get('hist',[]);
    body.innerHTML=`<div class="vn-card"><span class="vn-lbl">histórico (${h.length})</span>
 ${h.length?h.slice(0,40).map(x=>`<div class="vn-item"><b>${x.assunto}</b> ${x.conf} · ${x.fonte} · ${x.ms}ms</div>`).join(''):'<div class="vn-mini">vazio</div>'}
 <div class="vn-row"><button class="act" id="vn-hl">limpar</button></div></div>`;
    body.querySelector('#vn-hl').onclick=()=>{LS.del('hist');desenhar()};
  }
  if(aba==='cfg'){
    body.innerHTML=`
<label><input type="checkbox" id="c-ia" ${usarIA()?'checked':''}> IA habilitada</label>
<label><input type="checkbox" id="c-fb" ${fallbackOn()?'checked':''}> usar outras IAs automaticamente quando necessário</label>
<label><input type="checkbox" id="c-dica" ${usarDicas()?'checked':''}> usar dicas da página</label>
<label><input type="checkbox" id="c-gab" ${usarGab()?'checked':''}> usar gabarito interno (itemData)</label>
<div class="vn-card"><span class="vn-lbl">timeout (s)</span><input class="vn-in" id="c-to" type="number" min="4" max="60" value="${cfg('timeout',12)}"></div>
<div class="vn-card"><span class="vn-lbl">Cloudflare account id</span><input class="vn-in" id="c-acc" value="${cfg('acc','')}"></div>
<div class="vn-card"><span class="vn-lbl">proxy próprio (opcional)</span>
 <input class="vn-in" id="c-proxy" value="${cfg('proxy','')}" placeholder="https://meu-proxy/chat">
 <div class="vn-mini">Sem proxy, a chave fica em localStorage. Com proxy, fica no servidor.</div></div>
<div class="vn-row"><button class="act" id="c-clear">apagar memória e histórico</button></div>
<div class="vn-row"><button class="act" id="c-rm">remover Venice</button></div>`;
    body.querySelector('#c-ia').onchange=e=>{setCfg('usarIA',e.target.checked);desenhar()};
    body.querySelector('#c-fb').onchange=e=>{setCfg('fallback',e.target.checked);desenhar()};
    body.querySelector('#c-dica').onchange=e=>{setCfg('usarDicas',e.target.checked);desenhar()};
    body.querySelector('#c-gab').onchange=e=>{setCfg('usarGab',e.target.checked);if(e.target.checked){hooks(true);semearHTML()}else hooks(false);desenhar()};
    body.querySelector('#c-to').onchange=e=>{setCfg('timeout',+e.target.value||12);desenhar()};
    body.querySelector('#c-acc').onchange=e=>setCfg('acc',e.target.value.trim());
    body.querySelector('#c-proxy').onchange=e=>setCfg('proxy',e.target.value.trim());
    body.querySelector('#c-clear').onclick=()=>{LS.limpar(false);desenhar('memória e histórico apagados')};
    body.querySelector('#c-rm').onclick=()=>window.__venice.destroy();
  }
}

function desenharIA(){
  const principal=principalId(),ordem=ativos(),mig=LS.get('migr',[]);
  body.innerHTML=`
<div class="vn-card"><span class="vn-lbl">IA principal</span>
 <div class="vn-mini">${principal?`<b>${pById(principal)?.nome}</b> · ${estDe(principal).modelo||'sem modelo'}`:'nenhuma escolhida'}</div>
 <div class="vn-mini">fallback: ${fallbackOn()?'ativo — '+(ordem.map(i=>pById(i)?.nome).join(' → ')||'sem reservas'):'desligado'}</div></div>
${mig.length?`<div class="vn-card"><span class="vn-lbl">migração</span>${mig.map(m=>'<div class="vn-mini">· '+m+'</div>').join('')}</div>`:''}
${avisoAtual?`<div class="vn-card vn-mini">${avisoAtual}</div>`:''}
${PROV.filter(x=>x.id!=='custom').map(x=>{
  const e=estDe(x.id),k=keyDe(x),s=stats()[x.id];
  const cls=!k?'off':e.ativo?'on':'key';
  const mods=MODELOS.filter(m=>m.p===x.id).sort((a,b)=>b.ord-a.ord);
  return `<div class="vn-item"><span class="dot ${cls}"></span><b>${x.nome}</b>
   <span class="vn-mini">${x.tier}${e.ativo?' · ATIVA':''}${principal===x.id?' · PRINCIPAL':''}</span>
   <div class="vn-row"><input class="vn-in" type="password" id="k-${x.id}" placeholder="${k?'chave salva':''}">
     <button class="act" data-s="${x.id}" style="flex:0 0 52px">salvar</button>
     <button class="act" data-t2="${x.id}" style="flex:0 0 44px">testar</button></div>
   <div class="vn-row"><select class="vn-sel" data-m="${x.id}"><option value="">— modelo —</option>
     ${mods.map(m=>`<option value="${m.id}" ${e.modelo===m.id?'selected':''}>${m.n} · M${m.mat} V${m.vel}</option>`).join('')}</select></div>
   <div class="vn-row"><button class="act ${e.ativo?'on':''}" data-a="${x.id}" style="flex:0 0 74px">${e.ativo?'Desativar':'Ativar'}</button>
     <button class="act" data-p="${x.id}" style="flex:0 0 62px">principal</button>
     <button class="act" data-up="${x.id}" style="flex:0 0 26px">↑</button>
     <button class="act" data-dn="${x.id}" style="flex:0 0 26px">↓</button>
     <button class="act" data-rm="${x.id}" style="flex:0 0 26px">×</button></div>
   <div class="vn-mini">${s?`ok ${s.ok}/${s.n} · ${s.ms}ms`:'sem uso'}${x.doc?` · <a href="${x.doc}" target="_blank" style="color:#7fb2ff">doc</a>`:''}</div></div>`}).join('')}
<div class="vn-card"><span class="vn-lbl">personalizado</span>
 <input class="vn-in" id="cu-url" placeholder="endpoint" value="${cfg('customUrl','')}">
 <input class="vn-in" id="cu-mod" placeholder="modelo" value="${cfg('customModel','')}" style="margin-top:4px">
 <div class="vn-row"><button class="act" id="cu-save">salvar endpoint</button></div></div>`;
  body.querySelectorAll('[data-s]').forEach(b=>b.onclick=()=>{
    const id=b.dataset.s,v=body.querySelector('#k-'+id).value.trim();
    if(!v)return avisoAtual='cole a chave antes',desenhar();
    setKey(pById(id),v);delete cool[id];LS.set('cool',cool);
    avisoAtual='chave de '+pById(id).nome+' salva — teste e ative';desenhar()});
  body.querySelectorAll('[data-t2]').forEach(b=>b.onclick=async()=>{
    const id=b.dataset.t2;b.textContent='…';const r=await testar(id);
    avisoAtual=r.ok?'teste ok em '+pById(id).nome+' ('+r.ms+'ms)':'teste falhou: '+r.erro;desenhar()});
  body.querySelectorAll('[data-a]').forEach(b=>b.onclick=async()=>{
    const id=b.dataset.a;
    if(estDe(id).ativo){setEst(id,{ativo:false});avisoAtual=pById(id).nome+' desativada';return desenhar()}
    if(!keyDe(pById(id))){avisoAtual='salve a chave antes';return desenhar()}
    if(!estDe(id).modelo){avisoAtual='escolha um modelo antes';return desenhar()}
    b.textContent='testando…';const r=await testar(id);
    if(!r.ok){avisoAtual='não ativada: '+r.erro;return desenhar()}
    setEst(id,{ativo:true});if(!principalId())setCfg('principal',id);
    avisoAtual=pById(id).nome+' ativada';desenhar()});
  body.querySelectorAll('[data-p]').forEach(b=>b.onclick=()=>{
    const id=b.dataset.p;
    if(!estDe(id).ativo){avisoAtual='ative antes de tornar principal';return desenhar()}
    setCfg('principal',id);avisoAtual=pById(id).nome+' é agora a principal';desenhar()});
  body.querySelectorAll('[data-m]').forEach(s=>s.onchange=()=>{setEst(s.dataset.m,{modelo:s.value});desenhar()});
  const mover=(id,d)=>{
    const e=estadoIA(),at=Object.keys(e).sort((a,b)=>(e[a].prioridade||50)-(e[b].prioridade||50));
    const i=at.indexOf(id),j=i+d;if(i<0||j<0||j>=at.length)return;
    [at[i],at[j]]=[at[j],at[i]];at.forEach((x,n)=>setEst(x,{prioridade:(n+1)*10}));desenhar()};
  body.querySelectorAll('[data-up]').forEach(b=>b.onclick=()=>mover(b.dataset.up,-1));
  body.querySelectorAll('[data-dn]').forEach(b=>b.onclick=()=>mover(b.dataset.dn,1));
  body.querySelectorAll('[data-rm]').forEach(b=>b.onclick=()=>{
    const id=b.dataset.rm;LS.del('key:'+id);setEst(id,{ativo:false});
    if(principalId()===id)setCfg('principal','');
    avisoAtual=pById(id).nome+' removida';desenhar()});
  body.querySelector('#cu-save').onclick=()=>{
    setCfg('customUrl',body.querySelector('#cu-url').value.trim());
    setCfg('customModel',body.querySelector('#cu-mod').value.trim());
    avisoAtual='endpoint salvo';desenhar()};
}
desenhar();

const obs=new MutationObserver(()=>{clearTimeout(obs._t);obs._t=setTimeout(checarTroca,400)});
document.addEventListener('keydown',at,true);
function at(e){
  if(e.altKey&&e.key.toLowerCase()==='r'){e.preventDefault();resolver(false)}
  if(e.altKey&&e.key.toLowerCase()==='c'){e.preventDefault();copiar()}
}
window.__venice={destroy(){
  obs.disconnect();document.removeEventListener('keydown',at,true);
  hooks(false);box.remove();st.remove();delete window.__venice;
},resolver,conferir,copiar,testar};

migrar();
if(usarGab()){hooks(true);semearHTML()}
obs.observe(document.body,{childList:true,subtree:true});
})();
