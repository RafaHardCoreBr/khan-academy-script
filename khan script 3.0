javascript:(function venice(){
'use strict';
const V='4.2', NS='vk4:';

/* ======================= 0. UTIL ======================= */
const norm=s=>String(s??'').replaceAll('\u00a0',' ').replace(/\s+/g,' ').trim();
const low=s=>norm(s).toLowerCase();
const wait=ms=>new Promise(r=>setTimeout(r,ms));
const hash=s=>{let h=5381;for(let i=0;i<s.length;i++)h=((h*33)^s.charCodeAt(i))>>>0;return h.toString(36)};
const LS={
  get:(k,d)=>{try{const v=localStorage.getItem(NS+k);return v===null?d:JSON.parse(v)}catch(e){return d}},
  set:(k,v)=>{try{localStorage.setItem(NS+k,JSON.stringify(v))}catch(e){}},
  del:k=>{try{localStorage.removeItem(NS+k)}catch(e){}},
  limpar:tudo=>{try{Object.keys(localStorage).filter(k=>k.startsWith(NS)&&(tudo||!/key:|cfg:estado/.test(k))).forEach(k=>localStorage.removeItem(k))}catch(e){}}
};
const cfg=(k,d)=>LS.get('cfg:'+k,d);
const setCfg=(k,v)=>LS.set('cfg:'+k,v);
const num=s=>{const m=String(s).replace(/\.(?=\d{3}\b)/g,'').replace(',','.').match(/-?\d+(?:\.\d+)?/);return m?parseFloat(m[0]):null};
const brl=n=>String(n).replace('.',',');
if(window.__venice?.destroy){try{window.__venice.destroy()}catch(e){}}

/* ======================= 1. MATEMÁTICA SEGURA ======================= */
const MAT=function(){
  const pre=s=>low(s)
    .replace(/r\$\s*/g,'').replace(/(\d),(\d)/g,'$1.$2')
    .replace(/[×·∙]/g,'*').replace(/[÷:]/g,'/').replace(/[−–—]/g,'-')
    .replace(/raiz quadrada de/g,'sqrt').replace(/raiz c[úu]bica de/g,'cbrt').replace(/√/g,'sqrt')
    .replace(/\bpi\b/g,'3.141592653589793')
    .replace(/(\d)\s*%/g,'($1/100)').replace(/%/g,'/100')
    .replace(/\bvezes\b/g,'*').replace(/\bmais\b/g,'+').replace(/\bmenos\b/g,'-')
    .replace(/\bdividido por\b/g,'/').replace(/\belevado a\b/g,'^');
  const token=s=>{const t=[];let i=0;
    while(i<s.length){const c=s[i];
      if(/\s/.test(c)){i++;continue}
      if(/[0-9.]/.test(c)){let j=i;while(j<s.length&&/[0-9.]/.test(s[j]))j++;
        const v=parseFloat(s.slice(i,j));if(!isNaN(v))t.push({t:'n',v});i=j;continue}
      if(/[a-z]/.test(c)){let j=i;while(j<s.length&&/[a-z]/.test(s[j]))j++;t.push({t:'f',v:s.slice(i,j)});i=j;continue}
      if('+-*/^()'.includes(c)){t.push({t:c});i++;continue}
      i++}
    return t};
  const prec={'+':1,'-':1,'*':2,'/':2,'^':3};
  const rpn=t=>{const out=[],op=[];
    for(const k of t){
      if(k.t==='n'||k.t==='f'){out.push(k);continue}
      if(k.t==='('){op.push(k);continue}
      if(k.t===')'){while(op.length&&op[op.length-1].t!=='(')out.push(op.pop());op.pop();continue}
      const p=prec[k.t]||0;
      while(op.length&&op[op.length-1].t!=='('&&(prec[op[op.length-1].t]||0)>=p&&k.t!=='^')out.push(op.pop());
      op.push(k)}
    while(op.length)out.push(op.pop());return out};
  const calc=r=>{const st=[];
    for(const k of r){
      if(k.t==='n'){st.push(k.v);continue}
      if(k.t==='f'){const a=st.pop();
        if(k.v==='sqrt')st.push(a===undefined?NaN:Math.sqrt(a));
        else if(k.v==='cbrt')st.push(a===undefined?NaN:Math.cbrt(a));
        else return NaN;continue}
      const b=st.pop(),a=st.pop();
      if(a===undefined||b===undefined)return NaN;
      st.push(k.t==='+'?a+b:k.t==='-'?a-b:k.t==='*'?a*b:k.t==='/'?a/b:Math.pow(a,b))}
    return st.length===1?st[0]:NaN};
  return {
    avaliar(s){const t=token(pre(s));if(!t.some(k=>k.t==='n'))return NaN;
      if(!t.some(k=>['+','-','*','/','^'].includes(k.t))&&t.filter(k=>k.t==='n').length<2)return NaN;
      const v=calc(rpn(t));return isFinite(v)?v:NaN},
    casas(txt){const t=low(txt),w={uma:1,duas:2,'três':3,tres:3,quatro:4,zero:0};
      const m=t.match(/(\d+|uma|duas|três|tres|quatro|zero)\s+casas?/);
      if(m)return w[m[1]]!==undefined?w[m[1]]:+m[1];
      return /inteiro|n[úu]mero inteiro/.test(t)?0:null},
    arred(v,c){if(c===null||c===undefined)return v;const f=Math.pow(10,c);return Math.round(v*f)/f},
    mdc(a,b){a=Math.abs(a);b=Math.abs(b);while(b){[a,b]=[b,a%b]}return a||1},
    fracao(a,b){const d=this.mdc(a,b);return [a/d,b/d]},
    casar(valor,opcoes){
      for(const o of opcoes){const n=num(o);if(n!==null&&Math.abs(n-valor)<1e-6)return o}
      const alvo=brl(Number(valor.toFixed(4)));
      for(const o of opcoes)if(low(o).includes(alvo)||low(o).includes(String(valor)))return o;
      return null}
  };
}();

/* ======================= 2. EXTRAÇÃO (escopo correto) ======================= */
function container(){
  return document.querySelector('#problemarea')
    ||document.querySelector('[data-testid="perseus-renderer"]')
    ||document.querySelector('.framework-perseus')
    ||document.querySelector('[class*="problem-card"]')
    ||document.querySelector('main')||document.body;
}
function textoDe(root){
  const partes=[];
  const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode(n){
    if(!n.nodeValue.trim())return NodeFilter.FILTER_REJECT;
    let p=n.parentElement;
    while(p&&p!==root){
      if(p.matches&&p.matches('nav,header,aside,footer,script,style,[role="navigation"],[class*="sidebar"],[class*="footer"]'))
        return NodeFilter.FILTER_REJECT;
      p=p.parentElement;
    }
    return NodeFilter.FILTER_ACCEPT;
  }});
  let n;while((n=w.nextNode()))partes.push(norm(n.nodeValue));
  return partes;
}
const RUIDO=/^(mostrar dicas?|mostrar próxima dica|mostrar proxima dica|verificar|concluir|próxima pergunta|proxima pergunta|dica|calculadora|escolha \d+ resposta|enviar|pular|revisar|voltar)$/i;
function lerEnunciado(){
  const linhas=textoDe(container()).filter(s=>s&&!RUIDO.test(s)&&s.length<600);
  return linhas.join('\n').slice(0,1600);
}
function lerOpcoes(){
  const r=container(),out=[];
  r.querySelectorAll('li').forEach(li=>{
    const t=norm(li.innerText);
    if(t&&t.length<400&&!li.querySelector('li'))out.push(t)});
  if(out.length<2){
    r.querySelectorAll('[role="radio"],[data-testid*="choice"]').forEach(el=>{
      const t=norm(el.innerText);if(t&&t.length<400)out.push(t)});
  }
  return [...new Set(out)];
}
function lerCampos(){
  const out=[];
  container().querySelectorAll('input,textarea').forEach((el,i)=>{
    if(el.type==='hidden')return;
    out.push({tipo:el.tagName==='TEXTAREA'?'texto':'numero',el,idx:i})});
  return out;
}
const lerDicas=()=>[...container().querySelectorAll('[data-testid="hint"], .perseus-hint, [class*="hint-block"]')]
  .map(b=>norm(b.innerText)).filter(Boolean);

/* ======================= 3. GABARITO OPCIONAL ======================= */
const pool=new Map();
const flagOf=c=>{if(!c||typeof c!=='object')return null;
  if(c.correct===true||c.status==='correct'||c.considered==='correct')return 'ok';
  if(c.correct===false||c.status==='wrong'||c.considered==='wrong')return 'bad';return null};
function ingerirItem(str){
  let it;try{it=JSON.parse(str)}catch(e){return 0}
  const q=it&&(it.question||it);
  if(!q||typeof q.content!=='string'||!q.widgets)return 0;
  const base=hash(q.content);let n=0;
  for(const k of Object.keys(q.widgets)){
    const o=q.widgets[k].options||{};
    const r={type:k.split(' ')[0],correct:[],nums:[],forms:[]};
    if(Array.isArray(o.choices))o.choices.forEach((c,i)=>{if(flagOf(c)==='ok')r.correct.push(i)});
    if(Array.isArray(o.answers))o.answers.forEach(a=>{
      if(a&&(a.status==='correct'||a.status==='acceptable')&&a.value!==undefined)r.nums.push(String(a.value))});
    if(o.inexact===false&&o.value!==undefined)r.nums.push(String(o.value));
    if(Array.isArray(o.answerForms))o.answerForms.forEach(f=>{
      if(f&&(f.considered==='correct'||f.status==='correct'))r.forms.push(String(f.value))});
    pool.set(base+':'+n,r);n++}
  return n;
}
function ingerirJSON(txt){
  if(!txt||txt.indexOf('itemData')<0)return;
  let j;try{j=JSON.parse(txt)}catch(e){return}
  let a=0;
  (function w(x,d){if(!x||typeof x!=='object'||d>12||a>60)return;
    for(const k in x){const v=x[k];
      if(k==='itemData'&&typeof v==='string'){a+=ingerirItem(v);continue}
      if(v&&typeof v==='object')w(v,d+1)}})(j,0);
}
const fetchOrig=window.fetch, xhrOpen=XMLHttpRequest.prototype.open, xhrSend=XMLHttpRequest.prototype.send;
const ehItem=u=>/getAssessmentItem|assessment_item/i.test(String(u||''));
function hooks(on){
  if(!on){window.fetch=fetchOrig;XMLHttpRequest.prototype.open=xhrOpen;XMLHttpRequest.prototype.send=xhrSend;return}
  window.fetch=function(...a){
    const p=fetchOrig.apply(this,a);
    try{const u=(typeof a[0]==='string'?a[0]:a[0]&&a[0].url)||'';
      if(ehItem(u))p.then(r=>{try{r.clone().text().then(ingerirJSON).catch(()=>{})}catch(e){}}).catch(()=>{})}catch(e){}
    return p};
  XMLHttpRequest.prototype.open=function(m,u,...r){this.__vk=u;return xhrOpen.call(this,m,u,...r)};
  XMLHttpRequest.prototype.send=function(...a){
    if(ehItem(this.__vk))this.addEventListener('load',()=>{try{ingerirJSON(this.responseText)}catch(e){}});
    return xhrSend.apply(this,a)};
}
function semearHTML(){
  const html=document.documentElement.innerHTML;
  if(html.indexOf('itemData')<0)return;
  const re=/"itemData":"((?:[^"\\]|\\.)*)"/g;let m,g=0;
  while((m=re.exec(html))&&g++<80){try{ingerirItem(JSON.parse('"'+m[1]+'"'))}catch(e){}}
}

/* ======================= 4. CLASSIFICAÇÃO ======================= */
const ASSUNTO=[
 ['geometria',/área|area|perímetro|perimetro|volume|circunferência|circunferencia|triângulo|triangulo|retângulo|retangulo|raio|diâmetro|diametro/],
 ['porcentagem',/%|por cento|desconto|aumento percentual/],
 ['fracao',/fra[çc][ãa]o|numerador|denominador|\d+\s*\/\s*\d+/],
 ['proporcao',/propor[çc][ãa]o|raz[ãa]o|escala|regra de tr[êe]s/],
 ['equacao',/equa[çc][ãa]o|resolva para|isole|inc[óo]gnita|valor de x/],
 ['potencia',/pot[êe]ncia|expoente|elevado a/],
 ['raiz',/raiz quadrada|raiz c[úu]bica|√/],
 ['unidade',/converta|converter|quil[ôo]metro|polegada|milha/]
];
function classificar(txt,opcoes){
  const t=low(txt);let assunto=null;
  for(const [n,re] of ASSUNTO)if(re.test(t)){assunto=n;break}
  const temNum=/\d/.test(t);
  let tipo='calculo';
  if(opcoes.length>=2)tipo='opcoes';
  else if(!temNum&&/\?|explique|descreva|justifique|por que|o que é/.test(t))tipo='dissertativa';
  return {assunto:assunto||(temNum?'aritmetica':'geral'),tipo};
}

/* ======================= 5. SOLUCIONADORES ======================= */
function extrairExpressao(txt){
  const t=low(txt).replace(/r\$\s*/g,'').replace(/(\d),(\d)/g,'$1.$2')
    .replace(/[×·∙]/g,'*').replace(/[÷]/g,'/')
    .replace(/\bvezes\b/g,'*').replace(/\bmais\b/g,'+').replace(/\bmenos\b/g,'-')
    .replace(/\bdividido por\b/g,'/').replace(/\belevado a\b/g,'^')
    .replace(/raiz quadrada de/g,'sqrt').replace(/√/g,'sqrt');
  const cands=[...t.matchAll(/-?\d[\d\s.,+\-*/^()]*[\d)]/g)].map(m=>norm(m[0]))
    .filter(s=>/[+\-*/^]/.test(s))
    .sort((a,b)=>b.replace(/\s/g,'').length-a.replace(/\s/g,'').length);
  return cands[0]||null;
}
const SOLV={
  aritmetica(p){
    const e=extrairExpressao(p.texto);
    if(!e)return null;
    const v=MAT.avaliar(e);
    if(isNaN(v))return null;
    const r=MAT.arred(v,MAT.casas(p.texto));
    return {valores:[brl(r)],confianca:'alta',etapas:[`expressão encontrada: ${e}`,`conta: ${e} = ${brl(r)}`]};
  },
  porcentagem(p){
    const m=low(p.texto).match(/([\d.,]+)\s*%\s*(?:de|do|da)\s*([\d.,]+)/);
    if(!m)return null;
    const a=num(m[1]),b=num(m[2]);if(a===null||b===null)return null;
    const r=MAT.arred(a/100*b,MAT.casas(p.texto));
    return {valores:[brl(r)],confianca:'alta',
      etapas:[`${brl(a)}% de ${brl(b)}`,`${brl(a)}/100 × ${brl(b)} = ${brl(r)}`]};
  },
  fracao(p){
    const m=low(p.texto).match(/(\d+)\s*\/\s*(\d+)/);if(!m)return null;
    const a=+m[1],b=+m[2];if(!b)return null;
    const [x,y]=MAT.fracao(a,b);
    return {valores:[`${x}/${y}`,brl(a/b)],confianca:'media',
      etapas:[`fração lida: ${a}/${b}`,`simplificando por ${MAT.mdc(a,b)}: ${x}/${y}`,`decimal: ${brl(a/b)}`]};
  },
  proporcao(p){
    const ns=(low(p.texto).match(/\d+(?:[.,]\d+)?/g)||[]).map(num).filter(n=>n!==null);
    if(ns.length<3)return null;
    const [a,b,c]=ns;if(!a)return null;
    const r=MAT.arred(b*c/a,MAT.casas(p.texto));
    return {valores:[brl(r)],confianca:'media',
      etapas:[`proporção: ${brl(a)} → ${brl(b)}`,`${brl(c)} → x`,`x = ${brl(b)} × ${brl(c)} / ${brl(a)} = ${brl(r)}`]};
  },
  equacao(p){
    const m=p.texto.match(/(-?\d*)\s*x\s*([+-]\s*\d+)?\s*=\s*(-?\d+)/i);if(!m)return null;
    const a=m[1]===''||m[1]==='+'?1:m[1]==='-'?-1:parseFloat(m[1]);
    const b=m[2]?parseFloat(m[2].replace(/\s/g,'')):0,c=parseFloat(m[3]);
    if(!a)return null;
    const x=(c-b)/a;
    return {valores:[brl(x)],confianca:'alta',
      etapas:[`equação: ${brl(a)}x ${b>=0?'+ '+brl(b):'- '+brl(-b)} = ${brl(c)}`,`passa ${brl(b)} para a direita: ${brl(a)}x = ${brl(c-b)}`,`x = ${brl(x)}`]};
  },
  potencia(p){
    const m=low(p.texto).match(/([\d.,]+)\s*(?:\^|elevado a)\s*([\d.,]+)/);if(!m)return null;
    const r=Math.pow(num(m[1]),num(m[2]));if(!isFinite(r))return null;
    return {valores:[brl(r)],confianca:'alta',etapas:[`${m[1]} elevado a ${m[2]} = ${brl(r)}`]};
  },
  raiz(p){
    const m=low(p.texto).match(/raiz quadrada de\s*([\d.,]+)|√\s*([\d.,]+)/);if(!m)return null;
    const n=num(m[1]||m[2]),r=Math.sqrt(n);if(isNaN(r))return null;
    return {valores:[brl(r)],confianca:Number.isInteger(r)?'alta':'media',etapas:[`√${brl(n)} = ${brl(r)}`]};
  },
  unidade(p){
    const t=low(p.texto);
    const m=t.match(/([\d.,]+)\s*(km|m|cm|mm|kg|g|mg|l|ml|h|min|s)\b.*?(?:para|em)\s*(km|m|cm|mm|kg|g|mg|l|ml|h|min|s)\b/);
    if(!m)return null;
    const tab={km:1000,m:1,cm:0.01,mm:0.001,kg:1000,g:1,mg:0.001,l:1,ml:0.001,h:3600,min:60,s:1};
    if(!(m[2] in tab)||!(m[3] in tab))return null;
    const r=num(m[1])*tab[m[2]]/tab[m[3]];
    return {valores:[brl(MAT.arred(r,MAT.casas(p.texto)))],confianca:'alta',
      etapas:[`${m[1]} ${m[2]} × ${tab[m[2]]} ÷ ${tab[m[3]]} = ${brl(MAT.arred(r,4))} ${m[3]}`]};
  },
  geometria(p){
    const t=low(p.texto);
    const ns=(t.match(/\d+(?:[.,]\d+)?/g)||[]).map(num).filter(n=>n!==null);
    if(!ns.length)return null;
    if(/c[íi]rculo|circunfer/.test(t)&&/área|area/.test(t)){
      const r=ns[0],v=Math.PI*r*r;
      return {valores:[brl(MAT.arred(v,MAT.casas(p.texto)??2))],confianca:'alta',
        etapas:[`fórmula da área do círculo: π·r²`,`π·${brl(r)}² = ${brl(v)}`]}}
    if(/retângulo|retangulo|quadrado/.test(t)&&/área|area/.test(t)&&ns.length>=2){
      const v=ns[0]*ns[1];
      return {valores:[brl(v)],confianca:'alta',etapas:[`área = base × altura`,`${brl(ns[0])} × ${brl(ns[1])} = ${brl(v)}`]}}
    if(/triângulo|triangulo/.test(t)&&/área|area/.test(t)&&ns.length>=2){
      const v=ns[0]*ns[1]/2;
      return {valores:[brl(v)],confianca:'alta',etapas:[`área = base × altura ÷ 2`,`${brl(ns[0])} × ${brl(ns[1])} ÷ 2 = ${brl(v)}`]}}
    if(/volume/.test(t)&&ns.length>=3){
      const v=ns[0]*ns[1]*ns[2];
      return {valores:[brl(v)],confianca:'alta',etapas:[`volume = ${brl(ns[0])} × ${brl(ns[1])} × ${brl(ns[2])} = ${brl(v)}`]}}
    if(/perímetro|perimetro/.test(t)&&ns.length>=2){
      const v=2*(ns[0]+ns[1]);
      return {valores:[brl(v)],confianca:'media',etapas:[`perímetro = 2 × (${brl(ns[0])} + ${brl(ns[1])}) = ${brl(v)}`]}}
    return null;
  },
  dissertativa(p){
    const t=low(p.texto),top=[];
    if(/por que|justifique/.test(t))top.push('causa → consequência');
    if(/compare|diferen[çc]a/.test(t))top.push('semelhanças e diferenças');
    if(/import[âa]ncia|impacto/.test(t))top.push('relevância e efeitos');
    if(/exemplo/.test(t))top.push('exemplo concreto');
    if(!top.length)top.push('definição','exemplo','conclusão');
    const d=lerDicas();
    const etapas=['o enunciado pede texto, não número'];
    if(d.length)etapas.push('a própria dica da página entrega o eixo: '+d.join(' ').slice(0,240));
    etapas.push('estrutura sugerida: '+top.join(' → '));
    return {valores:[],confianca:'baixa',etapas};
  }
};
/* cascata: assunto primeiro, depois todos os outros */
const ORDEM=['aritmetica','porcentagem','fracao','proporcao','equacao','potencia','raiz','unidade','geometria'];
function resolverLocal(p){
  const tentativas=[];
  const fila=[...(p.assunto&&SOLV[p.assunto]?[p.assunto]:[]),...ORDEM.filter(x=>x!==p.assunto),
    ...(p.tipo==='dissertativa'?['dissertativa']:[])];
  for(const nome of fila){
    const r=SOLV[nome](p);
    if(r&&(r.valores.length||r.etapas.length))return Object.assign(r,{metodo:'local: '+nome});
    tentativas.push(nome);
  }
  return {valores:[],etapas:[],metodo:'local',confianca:'baixa',falhou:true,
    motivo:'nenhum solucionador reconheceu os dados (tentei '+tentativas.length+' padrões)'};
}

/* ======================= 6. PROVEDORES ======================= */
const PROV=[
 {id:'gemini',nome:'Google Gemini',shape:'gemini',url:'https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent',doc:'https://ai.google.dev/gemini-api/docs',tier:'gratis-limite',pre:'AIza'},
 {id:'groq',nome:'Groq',shape:'openai',url:'https://api.groq.com/openai/v1/chat/completions',doc:'https://console.groq.com/docs',tier:'gratis-limite',pre:'gsk_'},
 {id:'cerebras',nome:'Cerebras',shape:'openai',url:'https://api.cerebras.ai/v1/chat/completions',doc:'https://inference-docs.cerebras.ai',tier:'gratis-limite',pre:'csk-'},
 {id:'openrouter',nome:'OpenRouter',shape:'openai',url:'https://openrouter.ai/api/v1/chat/completions',doc:'https://openrouter.ai/docs',tier:'gratis-limite',pre:'sk-or-v1'},
 {id:'mistral',nome:'Mistral AI',shape:'openai',url:'https://api.mistral.ai/v1/chat/completions',doc:'https://docs.mistral.ai',tier:'gratis-limite',pre:''},
 {id:'sambanova',nome:'SambaNova',shape:'openai',url:'https://api.sambanova.ai/v1/chat/completions',doc:'https://docs.sambanova.ai',tier:'gratis-limite',pre:''},
 {id:'cohere',nome:'Cohere',shape:'cohere',url:'https://api.cohere.com/v1/chat',doc:'https://docs.cohere.com',tier:'gratis-limite',pre:''},
 {id:'nvidia',nome:'NVIDIA NIM',shape:'openai',url:'https://integrate.api.nvidia.com/v1/chat/completions',doc:'https://docs.nvidia.com/nim',tier:'creditos',pre:'nvapi-'},
 {id:'zai',nome:'Z.AI',shape:'openai',url:'https://api.z.ai/api/paas/v4/chat/completions',doc:'https://docs.z.ai',tier:'creditos',pre:''},
