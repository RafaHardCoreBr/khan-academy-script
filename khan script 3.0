const pById=id=>PROV.find(p=>p.id===id);
const keyDe=p=>LS.get('key:'+p.id,'');
const setKey=(p,v)=>LS.set('key:'+p.id,v);
const estadoIA=()=>cfg('estado',{});
const estDe=id=>estadoIA()[id]||{};
function setEst(id,patch){
  const e=estadoIA();e[id]=Object.assign({ativo:false,modelo:'',prioridade:50},e[id]||{},patch);
  setCfg('estado',e);
}
const principalId=()=>cfg('principal','');
const fallbackOn=()=>cfg('fallback',false);
const usarIA=()=>cfg('usarIA',true);
const usarGab=()=>cfg('usarGab',false);
const usarDicas=()=>cfg('usarDicas',true);
const stats=()=>LS.get('stats',{});
const marcar=(id,ok,ms)=>{const s=stats(),r=s[id]||{n:0,ok:0,ms:0};
  r.n++;if(ok)r.ok++;r.ms=r.ms?Math.round((r.ms+ms)/2):ms;s[id]=r;LS.set('stats',s)};
const cool=LS.get('cool',{});
function ativos(){
  const e=estadoIA();
  return Object.keys(e).filter(id=>e[id].ativo&&keyDe(pById(id)||{id}))
    .sort((a,b)=>(e[a].prioridade||50)-(e[b].prioridade||50));
}
function migrar(){
  const achados=[],pares=[];
  try{
    for(let i=0;i<localStorage.length;i++){
      const k=localStorage.key(i);if(!k)continue;
      if(k.startsWith('vk4:key:'))pares.push([k.replace('vk4:key:',''),localStorage.getItem(k),'v4']);
      else if(k.startsWith('vk-key-'))pares.push([k.replace('vk-key-',''),localStorage.getItem(k),'v3']);
    }
  }catch(e){}
  for(const [id,val,origem] of pares){
    if(!val)continue;
    const p=pById(id);if(!p)continue;
    if(origem==='v3'){setKey(p,val);achados.push('chave de '+p.nome+' migrada');continue}
    if(p.pre&&!val.startsWith(p.pre)){
      const dono=PROV.find(x=>x.pre&&val.startsWith(x.pre)&&x.id!==id);
      if(dono){
        if(!keyDe(dono)){setKey(dono,val);LS.del('key:'+id);
          achados.push('chave estava em '+p.nome+', movida para '+dono.nome)}
        else achados.push('chave em '+p.nome+' parece de '+dono.nome+' — confira');
      }
    }
  }
  if(achados.length)LS.set('migr',achados);
  return achados;
}

/* ======================= 7. CHAMADA ======================= */
const cache=new Map(), emVoo=new Map();
const cacheKey=(m,t)=>m+'|'+hash(t);
function adaptar(p,model,prompt){
  if(p.shape==='gemini')
    return {url:p.url.replace('{model}',model),
      headers:{'Content-Type':'application/json','x-goog-api-key':keyDe(p)},
      body:{contents:[{parts:[{text:prompt}]}],generationConfig:{temperature:0,maxOutputTokens:700}}};
  if(p.shape==='cohere')
    return {url:p.url,headers:{'Content-Type':'application/json',Authorization:'Bearer '+keyDe(p)},
      body:{model,message:prompt,temperature:0}};
  return {url:(p.url||cfg('customUrl','')).replace('{acc}',cfg('acc','')),
    headers:{'Content-Type':'application/json',Authorization:'Bearer '+keyDe(p)},
    body:{model,messages:[{role:'user',content:prompt}],temperature:0,max_tokens:700}};
}
const lerResposta=(p,j)=>{
  if(p.shape==='gemini')return j?.candidates?.[0]?.content?.parts?.map(x=>x.text).join('')||'';
  if(p.shape==='cohere')return j?.text||'';
  return j?.choices?.[0]?.message?.content||'';
};
async function umaChamada(p,model,prompt){
  const req=adaptar(p,model,prompt);
  const proxy=cfg('proxy','');
  const ctl=new AbortController();
  const lim=cfg('timeout',12)*1000;
  const t0=Date.now();
  const timer=setTimeout(()=>ctl.abort(),lim);
  try{
    let status=0,json=null;
    if(proxy){
      const r=await fetch(proxy,{method:'POST',signal:ctl.signal,headers:{'Content-Type':'application/json'},
        body:JSON.stringify({url:req.url,method:'POST',headers:req.headers,body:req.body})});
      const env=await r.json().catch(()=>null);
      status=env?.status||r.status;json=env?.json||env;
    }else{
      const r=await fetch(req.url,{method:'POST',headers:req.headers,signal:ctl.signal,body:JSON.stringify(req.body)});
      status=r.status;json=await r.json().catch(()=>null);
      if(status===429){
        const ra=+r.headers.get('Retry-After')||30;
        cool[p.id]=Date.now()+ra*1000;LS.set('cool',cool);
        throw new Error(`${p.nome}: limite (429, ${ra}s)`);
      }
    }
    if(status===401||status===403)throw new Error(`${p.nome}: chave recusada (${status})`);
    if(status===404)throw new Error(`${p.nome}: modelo/endpoint inexistente (404)`);
    if(status===400)throw new Error(`${p.nome}: requisição inválida (400)`);
    if(status>=500)throw new Error(`${p.nome}: servidor ${status}`);
    if(status===429)throw new Error(`${p.nome}: limite (429)`);
    if(status&&status>=400)throw new Error(`${p.nome}: HTTP ${status}`);
    const txt=norm(lerResposta(p,json));
    if(!txt)throw new Error(p.nome+': resposta vazia');
    marcar(p.id,true,Date.now()-t0);
    return txt;
  }catch(e){
    marcar(p.id,false,Date.now()-t0);
    if(e.name==='AbortError')throw new Error(p.nome+': tempo esgotado');
    throw e;
  }finally{clearTimeout(timer)}
}
async function testar(id){
  const p=pById(id);
  if(!p)return {ok:false,erro:'provedor desconhecido'};
  if(!keyDe(p))return {ok:false,erro:'sem chave'};
  if(p.id==='cloudflare'&&!cfg('acc',''))return {ok:false,erro:'falta account id'};
  const modelo=estDe(id).modelo||(MODELOS.find(m=>m.p===id)||{}).id;
  if(!modelo)return {ok:false,erro:'escolha um modelo'};
  const t0=Date.now();
  try{await umaChamada(p,modelo,'Responda apenas: ok');return {ok:true,ms:Date.now()-t0}}
  catch(e){return {ok:false,erro:e.message}}
}
async function chamarIA(prompt,assunto){
  const principal=principalId(),lista=[];
  if(principal&&estDe(principal).ativo)lista.push(principal);
  if(fallbackOn())for(const id of ativos())if(!lista.includes(id))lista.push(id);
  if(!lista.length)throw new Error('nenhuma IA ativa — ative uma na aba IAs');
  const primeiro=lista[0], modelo1=estDe(primeiro).modelo||(MODELOS.find(m=>m.p===primeiro)||{}).id;
  const ck=cacheKey(primeiro+(modelo1||''),assunto+prompt);
  if(cache.has(ck))return {texto:cache.get(ck),fonte:'cache',quem:null,falhas:[]};
  if(emVoo.has(ck))return {texto:(await emVoo.get(ck)).texto,fonte:'junto',quem:null,falhas:[]};
  const tarefa=(async()=>{
    const falhas=[];
    for(const id of lista){
      const p=pById(id);
      const modelo=estDe(id).modelo||(MODELOS.find(m=>m.p===id)||{}).id;
      if(!modelo){falhas.push(`${p.nome}: sem modelo`);continue}
      if((cool[id]||0)>Date.now()){falhas.push(`${p.nome}: em espera`);continue}
      try{
        const txt=await umaChamada(p,modelo,prompt);
        cache.set(ck,txt);
        return {texto:txt,quem:p.nome+' · '+modelo,falhas};
      }catch(e){falhas.push(e.message)}
    }
    throw new Error(falhas.join(' / ')||'todas as IAs falharam');
  })();
  emVoo.set(ck,tarefa);
  try{
    const r=await tarefa;
    return {texto:r.texto,fonte:r.falhas.length?'fallback':'rede',quem:r.quem,falhas:r.falhas};
  }finally{emVoo.delete(ck)}
}
function promptDe(p,assunto,erro){
  const cab={aritmetica:'Resolva a conta. Uma linha de cálculo.',
    porcentagem:'Resolva o percentual em uma linha.',
    fracao:'Trabalhe a fração e simplifique.',
    proporcao:'Regra de três, mostre a montagem.',
    equacao:'Isole a incógnita em 2 linhas.',
    potencia:'Calcule a potência.',raiz:'Calcule a raiz.',
    unidade:'Converta mostrando o fator.',
    geometria:'Use a fórmula e calcule.',
    dissertativa:'Monte 3 tópicos curtos de resposta.',
    geral:'Responda curto e correto.'}[assunto]||'Responda curto e correto.';
  const opc=p.opcoes.length?`\nAlternativas:\n${p.opcoes.map((o,i)=>`${i+1}) ${o}`).join('\n')}`:'';
  const campos=p.campos.length?`\nCampos: ${p.campos.map(c=>c.tipo).join(', ')}`:'';
  const err=erro?`\nTentativa anterior falhou (${erro}). Revise.`:'';
  return `${cab}\n\nEnunciado:\n${p.texto}${opc}${campos}${err}\n\nMáximo 5 linhas. Alternativa → número. Número → valor final.`;
}

